# Copy to .env and fill in. Placeholders only — never commit real secrets.

NODE_ENV=development
API_PORT=3000
LOG_LEVEL=debug

# PostgreSQL. Local development runs via infrastructure/compose.yaml.
DATABASE_URL=postgresql://smartschool:CHANGE_ME@127.0.0.1:55432/smartschool_dev

# Base connection used by the test harness to create/drop isolated test databases.
# Must point at the maintenance database, not a test database.
TEST_DATABASE_ADMIN_URL=postgresql://smartschool:CHANGE_ME@127.0.0.1:55432/postgres

# Auth. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME_GENERATE_A_RANDOM_48_BYTE_VALUE
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_SECONDS=2592000
ACTIVATION_TOKEN_TTL_SECONDS=259200

# Reverse-proxy hops in front of the API (0 when clients connect directly).
TRUST_PROXY=0

# Parent OTP login. `dev_outbox` keeps codes in process memory only (never logged) and refuses to
# run in production; `none` disables OTP login. No paid SMS vendor has been chosen.
SMS_PROVIDER=dev_outbox
# Optional HMAC key for stored OTP codes. Generate with: openssl rand -base64 48
# OTP_HASH_SECRET=
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# Attendance date policy: timezone used for "today", and how far back teachers may mark.
ATTENDANCE_TIMEZONE=Asia/Kolkata
ATTENDANCE_TEACHER_BACKDATE_DAYS=7
