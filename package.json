{
  "name": "smart-school",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "db:up": "podman compose -f infrastructure/compose.yaml up -d || docker compose -f infrastructure/compose.yaml up -d",
    "db:down": "podman compose -f infrastructure/compose.yaml down || docker compose -f infrastructure/compose.yaml down",
    "db:migrate": "pnpm --filter @smart-school/database migrate",
    "typecheck": "pnpm -r --no-bail typecheck",
    "lint": "eslint .",
    "test": "pnpm -r --no-bail test",
    "build": "pnpm -r build"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/node": "^22.18.6",
    "eslint": "^9.37.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.45.0"
  }
}
